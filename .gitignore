# CakeCraft - Recommended .gitignore
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails / Windows
Thumbs.db
ehthumbs.db

# Node dependencies and debug logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (sensitive)
.env
.env.*.local
.env.local

# Build / output directories
/dist
/build
/.parcel-cache
/.next
/.nuxt
/.vite
/.vercel
/.firebase
/out

# Test coverage and caches
.coverage
coverage/
.nyc_output/
.cache/
.tmp/

# Logs
logs/
*.log

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Swap / temp files
*.swp
*~

# Misc
.DS_Store?
__pycache__/
*.pyc

